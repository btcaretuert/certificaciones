---
/* Glifos de 24x24, solo trazo, heredando color con currentColor.
 *
 * Van inline en el markup y no como archivo ni como data: URI. No es una
 * preferencia: `img-src 'self'` cubre background-image y mask-image, asi que un
 * data:image/svg+xml en CSS dispara securitypolicyviolation y tumba
 * tests/e2e/csp.spec.ts. El markup, en cambio, no lo gobierna la CSP.
 *
 * Sin <style> propio, por lo mismo que Chip.astro: con assetsInlineLimit en 0
 * una hoja de componente compartida es un chunk y una peticion bloqueante mas.
 * La regla .ico vive en primitivas.css.
 *
 * Sin directiva de cliente, asi que este mapa no viaja al navegador: solo el
 * glifo elegido acaba en el HTML. Por eso tampoco se usan en las 252 filas de
 * la tabla, donde mil SVG inline si pesarian en el documento. */
const GLIFOS = {
  certificado:
    '<rect x="3.5" y="3" width="12" height="18" rx="1.8"/><path d="M7 8h5M7 11.5h3"/>' +
    '<circle cx="17" cy="16" r="3.4"/><path d="M15.2 18.8 14.7 22l2.3-1.3 2.3 1.3-.5-3.2"/>',
  escudo:
    '<path d="M12 3 5 6v5.5c0 4.3 2.9 8.2 7 9.5 4.1-1.3 7-5.2 7-9.5V6l-7-3Z"/>' +
    '<path d="m9 12 2.2 2.2L15.5 10"/>',
  documento:
    '<path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5L13.5 3Z"/>' +
    '<path d="M13.5 3v5.5H19"/><path d="M8.5 13h7M8.5 16.5h4.5"/>',
  verificable:
    '<path d="M10.5 13.5a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7l-1.3 1.3"/>' +
    '<path d="M13.5 10.5a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.3-1.3"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.4 2"/>',
  pmi:
    '<path d="m12 3 7.4 4.3v8.6L12 20.2 4.6 15.9V7.3L12 3Z"/>' +
    '<path d="m8.8 11.8 2.3 2.3 4.4-4.4"/>',
  grafo:
    '<circle cx="6" cy="17.5" r="2.5"/><circle cx="18" cy="17.5" r="2.5"/>' +
    '<circle cx="12" cy="6" r="2.5"/><path d="M10.3 7.9 7.7 15.6M13.7 7.9l2.6 7.7M8.5 17.5h7"/>',
  capas:
    '<path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z"/><path d="m3.5 12 8.5 4.5 8.5-4.5"/>' +
    '<path d="m3.5 16.5 8.5 4.5 8.5-4.5"/>',
  pipeline:
    '<circle cx="4.5" cy="12" r="2"/><circle cx="19.5" cy="6.5" r="2"/>' +
    '<circle cx="19.5" cy="17.5" r="2"/>' +
    '<path d="M6.5 12h4.2a2.5 2.5 0 0 0 2.1-1.2l1.2-2a2.5 2.5 0 0 1 2.1-1.2h1.4"/>' +
    '<path d="M6.5 12h4.2a2.5 2.5 0 0 1 2.1 1.2l1.2 2a2.5 2.5 0 0 0 2.1 1.2h1.4"/>',
  barras: '<path d="M4 20h16"/><path d="M7 20v-5M11.7 20V8M16.3 20v-8"/>',
  tabla:
    '<rect x="3.5" y="4.5" width="17" height="15" rx="1.8"/>' +
    '<path d="M3.5 9.5h17M9.5 9.5v10"/>',
  estrella:
    '<path d="m12 3.8 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 10l5.9-.9L12 3.8Z"/>',
} as const;

interface Props {
  nombre: keyof typeof GLIFOS;
  /** Lado del cuadro en px. */
  px?: number;
  /** Texto accesible. Sin el, el glifo es decorativo y se oculta a lectores. */
  titulo?: string;
}
const { nombre, px = 24, titulo } = Astro.props;
const contenido = (titulo ? `<title>${titulo}</title>` : '') + GLIFOS[nombre];
---
<svg
  class="ico"
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  set:html={contenido}
/>
