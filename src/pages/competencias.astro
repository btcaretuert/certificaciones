---
import Base from '@layouts/Base.astro';
import Icono from '@components/Icono.astro';
import { publishedCertificates, type PublishedCert } from '@lib/data';
import { agruparPorCompetencia, type GrupoCompetencia } from '@lib/skills';
import { hoursFloor } from '@lib/stats';
import { fmtHoras } from '@lib/format';
import { areaLabel } from '@lib/labels';
import { urlCert, urlCompetencias, urlHome, urlPdf } from '@lib/urls';

const certs = await publishedCertificates();
const grupos = agruparPorCompetencia(certs);
const { hours, itineraries } = hoursFloor(certs);
const hoy = new Date().toISOString().slice(0, 10);

// El tamaño del ruido que esta pagina existe para ordenar se cuenta en vivo
// sobre lo publicado, no se copia del comentario de skills.yaml: si mañana
// entran fichas nuevas, la cifra del texto sigue siendo cierta.
const usos = new Map<string, number>();
for (const c of certs) for (const s of c.skills) usos.set(s, (usos.get(s) ?? 0) + 1);
const etiquetasUnicas = [...usos.values()].filter((n) => n === 1).length;


/**
 * Horas de un area: sobre los certificados DISTINTOS que la respaldan.
 *
 * Sumar las horas de sus competencias daria mas —660 h en datos frente a 259—
 * porque un certificado respalda varias competencias a la vez y se contaria
 * una vez por cada una. Las competencias son facetas, no un reparto. Se
 * excluyen los itinerarios, igual que en el total del sitio.
 */
function agrupaArea(comps: GrupoCompetencia[]) {
  const unicos = new Map<string, PublishedCert>();
  for (const g of comps) for (const c of g.certs) unicos.set(c.id, c);
  const lista = [...unicos.values()];
  return {
    horas: Math.round(lista.filter((c) => c.kind !== 'itinerario').reduce((s, c) => s + (c.hours ?? 0), 0)),
    nCerts: lista.length,
  };
}

const porArea = new Map<string, GrupoCompetencia[]>();
for (const g of grupos) {
  if (!porArea.has(g.area)) porArea.set(g.area, []);
  porArea.get(g.area)!.push(g);
}

const areas = [...porArea.entries()]
  .map(([area, comps]) => ({
    area,
    // agruparPorCompetencia ya devuelve ordenado por horas; se reafirma aqui
    // porque el orden dentro del area es parte de lo que la pagina promete
    comps: [...comps].sort((a, b) => b.horas - a.horas || b.certs.length - a.certs.length),
    ...agrupaArea(comps),
  }))
  .sort((a, b) => b.horas - a.horas || b.nCerts - a.nCerts);

// Escala unica para todas las barras: comparar competencias entre areas es
// justamente lo que se quiere poder hacer de un vistazo.
const maxH = Math.max(1, ...grupos.map((g) => g.horas));
const maxArea = Math.max(1, ...areas.map((a) => a.horas));



/** Primero lo que pesa; los itinerarios al final, porque no suman horas. */
function ordenaCerts(lista: PublishedCert[]) {
  return [...lista].sort((a, b) => {
    const ia = a.kind === 'itinerario' ? 1 : 0;
    const ib = b.kind === 'itinerario' ? 1 : 0;
    if (ia !== ib) return ia - ib;
    return (b.hours ?? -1) - (a.hours ?? -1);
  });
}
---
<Base
  title="Competencias — Alejandro Retuert"
  description={`Las ${usos.size} etiquetas que emitieron las plataformas, agrupadas en ${grupos.length} competencias y ordenadas por horas de contenido.`}
  path={urlCompetencias()}
>
  <div class="top-nav wrap">
    <a href={urlHome()}>← Volver al catálogo completo</a>
  </div>

  <header class="hero">
    <div class="wrap">
      <p class="kicker">Matriz de competencias · Evidencia por dominio</p>
      <h1>Competencias</h1>
      <ul class="stats">
        <li class="eje"><b>{grupos.length}</b><span>competencias con evidencia</span><i>agrupadas desde {usos.size} etiquetas</i></li>
        <li><b>{certs.length}</b><span>certificados agrupados</span><i>un certificado respalda varias</i></li>
        <li><b>{hours} h</b><span>de contenido</span><i>excluye {itineraries} itinerarios</i></li>
      </ul>
      <div class="intro">
        <p>
          Esto no es una autoevaluación. Es la agrupación de las {usos.size} etiquetas distintas
          que las plataformas escribieron en los certificados — {etiquetasUnicas} de ellas aparecen
          una sola vez, y varias están repetidas en dos idiomas (Liderazgo y <i>Leadership</i>,
          Python y <i>Python (Programming Language)</i>). El vocabulario del sitio las reúne en
          {' '}{grupos.length} competencias. No hay nivel, ni puntaje, ni años de experiencia
          declarados: solo la etiqueta que puso el emisor y el certificado que la respalda, que
          puede abrirse y revisarse uno por uno.
        </p>
        <p>
          Las horas excluyen los {itineraries} itinerarios de LinkedIn Learning, que agrupan cursos
          ya contados aquí mismo. Un certificado respalda varias competencias a la vez, así que la
          suma de las competencias de un área es mayor que el total del área: ese total cuenta cada
          certificado una sola vez.
        </p>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section aria-labelledby="resumen">
      <h2 id="resumen"><Icono nombre="grafo" px={17} />Áreas <small>ordenadas por horas de contenido, no por número de certificados</small></h2>
      <div class="panel">
        <div class="bars">
          {areas.map((a) => (
            <a class="bar" href={`#${a.area}`}>
              <span class="bar-meta">
                <span class="lbl">{areaLabel(a.area)}</span>
                <span class="bar-val">{a.horas} h · {a.nCerts} certs</span>
              </span>
              <span class="track"><span class="fill" style={`width:${(a.horas / maxArea) * 100}%`}></span></span>
            </a>
          ))}
        </div>
        <p class="pie">La cifra de la derecha es el número de certificados distintos del área. Lo
          técnico son cursos largos y lo transversal cursos de una hora: ordenar por volumen
          invierte la lectura.</p>
      </div>
    </section>

    {areas.map((a) => (
      <section class="area" id={a.area} aria-labelledby={`h-${a.area}`}>
        <h2 id={`h-${a.area}`}>
          {areaLabel(a.area)}
          <small>{a.horas} h · {a.nCerts} certificados · {a.comps.length} competencias</small>
        </h2>
        <div class="comps">
          {a.comps.map((g) => (
            <details class="comp">
              <summary>
                <span class="chev" aria-hidden="true"></span>
                <span class="name">{g.es} <i>{g.en}</i></span>
                <span class="track"><span class="fill" style={`width:${(g.horas / maxH) * 100}%`}></span></span>
                <span class="stats-pill">{g.certs.length} certs · {g.horas} h</span>
              </summary>
              <ul class="lista">
                {ordenaCerts(g.certs).map((c) => (
                  <li class="item">
                    <div class="item-info">
                      <a class="item-name" href={urlCert(c.id)}>{c.title}</a>
                      <div class="item-meta">
                        <span>{c.issuer}{c.issued && ` · ${c.issued.slice(0, 4)}`}</span>
                        {c.kind === 'itinerario'
                          ? <span class="tag" title="Agrupa cursos que ya están en esta misma lista; sus horas no se suman">itinerario</span>
                          : c.hours !== null && <span class="tag">{fmtHoras(c.hours)}</span>}
                        {c.expires && (c.expires < hoy
                          ? <span class="estado exp" title={`Venció el ${c.expires}`}>vencida</span>
                          : <span class="estado vig" title={`Vigente hasta el ${c.expires}`}>vigente {c.expires.slice(0, 4)}</span>)}
                      </div>
                    </div>
                    <div class="item-acc">
                      {c.pdf && (
                        <a class="btn-doc" href={urlPdf(c.pdf)} target="_blank" rel="noopener noreferrer"
                           title={`Copia del certificado de «${c.title}», alojada en este sitio`}>PDF</a>
                      )}
                      {c.verify_url && (
                        <a class="btn-doc ver" href={c.verify_url} target="_blank" rel="noopener noreferrer"
                           title={`Verificar «${c.title}» en el sitio de ${c.issuer}`}>emisor ↗</a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </section>
    ))}

    <p class="foot"><a href={urlHome()}>← Volver al catálogo completo</a></p>
  </main>

  <style>
    .top-nav { padding-top: 24px; font-family: var(--mono); font-size: 13px; }
    .top-nav a { color: var(--accent); text-decoration: none; }
    .top-nav a:hover { text-decoration: underline; }

    .hero { border-bottom: 1px solid var(--line); padding: 26px 0 34px; margin-bottom: 40px; }
    h1 { font-size: clamp(28px, 5vw, 40px); font-weight: 700; margin-bottom: 20px; }
    .stats { margin: 0; }
    .intro { margin-top: 22px; max-width: 78ch; }
    .intro p { margin: 0 0 10px; color: var(--muted); font-size: 13px; line-height: 1.65; }
    .intro p:last-child { margin-bottom: 0; }
    .intro i { font-style: italic; }

    main { padding-bottom: 72px; }
    .pie { margin-top: 16px; font-size: 11.5px; line-height: 1.5; color: var(--dim); font-family: var(--mono); max-width: 80ch; }

    /* Barras del resumen: enlaces de salto al ancla del area. */
    .bar { display: block; text-decoration: none; padding: 2px 0; }
    .bar:hover .lbl { color: var(--accent); }
    .bar:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--radius-xs); }

    /* ── SECCIONES DE DOMINIO ─────────────────────────────────────────────── */
    .area h2 { padding-bottom: 10px; border-bottom: 1px solid var(--line); }
    .comps { display: grid; gap: 12px; }
    /* Cada competencia es una caja cerrada sobre si misma: cabecera con la
       cifra a la derecha y, al abrirla, la lista de credenciales que la
       respaldan. El borde es lo unico que cambia al abrirse; el fondo no, para
       que el contraste de la lista no dependa del estado. */
    .comp { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
    .comp[open] { border-color: var(--accent-borde); }
    summary {
      display: grid; grid-template-columns: 12px 1fr 150px auto; align-items: center; gap: 14px;
      padding: 14px 18px; cursor: pointer; font-size: 13.5px; list-style: none;
    }
    summary::-webkit-details-marker { display: none; }
    .comp[open] summary { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 40%, transparent); }
    summary:hover .name { color: var(--accent); }
    summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .chev { width: 0; height: 0; border-left: 5px solid currentColor; border-top: 4px solid transparent; border-bottom: 4px solid transparent; color: var(--muted); transition: transform .12s ease; }
    .comp[open] .chev { transform: rotate(90deg); }
    .name { font-weight: 600; color: var(--titulo); }
    .name i { font-style: normal; font-weight: 400; color: var(--muted); font-size: 12px; margin-left: 8px; font-family: var(--mono); }
    /* La cifra del dominio, como pastilla y no como dos columnas numericas:
       con 63 competencias, dos columnas de ancho fijo dejaban la mitad del
       espacio vacio en las que no llegan a tres digitos. */
    .stats-pill {
      font-family: var(--mono); font-size: 11.5px; color: var(--accent);
      background: var(--accent-soft); border: 1px solid var(--accent-borde);
      padding: 3px 9px; border-radius: var(--radius-xs); white-space: nowrap;
    }

    /* ── LISTA DE CREDENCIALES ────────────────────────────────────────────── */
    .lista { margin: 0; padding: 0; }
    .item {
      display: flex; align-items: baseline; justify-content: space-between; gap: 20px;
      padding: 12px 18px; border-bottom: 1px solid var(--line-suave);
    }
    .item:last-child { border-bottom: none; }
    .item:hover { background: color-mix(in srgb, var(--fg) 2%, transparent); }
    .item-info { flex: 1; min-width: 0; }
    .item-name { font-size: 13.5px; font-weight: 500; color: var(--fg); text-decoration: none; }
    .item-name:hover { color: var(--accent); text-decoration: underline; }
    .item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 5px; font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
    .item-meta .tag { font-size: 10.5px; padding: 1px 5px; color: var(--muted); }
    .item-acc { display: flex; gap: 6px; flex: none; }

    /* Estado de vigencia. Sin fondo tintado: --alerta sobre un tinte del 15%
       cae a 4.35 y queda bajo el minimo AA. */
    .estado { font-family: var(--mono); font-size: 10.5px; display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .estado.vig { color: var(--ok); }
    .estado.exp { color: var(--alerta); }
    .estado::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

    .foot { font-family: var(--mono); font-size: 13px; }
    .foot a { color: var(--accent); text-decoration: none; }
    .foot a:hover { text-decoration: underline; }

    @media (max-width: 720px) {
      summary { grid-template-columns: 12px 1fr auto; gap: 10px; padding: 12px 14px; }
      summary .track { display: none; }
      .item { flex-direction: column; align-items: stretch; gap: 8px; padding: 12px 14px; }
      .item-acc { justify-content: flex-start; }
    }
    @media (prefers-reduced-motion: reduce) { .chev { transition: none; } }
  </style>
</Base>
