---
import Base from '@layouts/Base.astro';
import Chip from '@components/Chip.astro';
import Icono from '@components/Icono.astro';
import { publishedCertificates, selectFeatured } from '@lib/data';
import { dimWebp } from '@lib/webp';
import { countBy, hoursFloor, techCoverage, timeline, evidence } from '@lib/stats';
import { urlCert, urlCompetencias, urlPdf, urlThumb } from '@lib/urls';
import { areaLabel, typeLabel, TYPE_LABEL } from '@lib/labels';

const certs = await publishedCertificates();
const featured = selectFeatured(certs);

/**
 * Alto y ancho REALES de cada miniatura destacada.
 *
 * Antes iban fijos en 640x480 y ninguna miniatura mide eso: la mayoria es
 * 640x495 y tres de las destacadas son 596x842, es decir A4 vertical
 * declarado como horizontal. El navegador reserva el hueco con la proporcion
 * del atributo, asi que la pagina saltaba al cargar justo en el bloque que
 * mas arriba esta.
 *
 * Son siete lecturas en build, no 252: solo los destacados llevan miniatura
 * en esta pagina. La ficha hace lo mismo desde getStaticPaths.
 */
const dims = new Map(
  featured.filter((c) => c.thumb).map((c) => [c.thumb!, dimWebp(c.thumb!)]),
);
const areas = countBy(certs, (c) => c.area).map(([a, n]) => ({
  area: a,
  n,
  // las horas del area excluyen itinerarios por el mismo motivo que el total
  h: Math.round(certs.filter((c) => c.area === a && c.kind !== 'itinerario')
    .reduce((s, c) => s + (c.hours ?? 0), 0)),
})).sort((x, y) => y.h - x.h || y.n - x.n);
const maxH = Math.max(1, ...areas.map((a) => a.h));
const tech = techCoverage(certs).filter((t) => t.n >= 2);
/**
 * Las doce del encabezado. Las 30 de `tech` ocupan tres filas en escritorio
 * pero quince en un telefono, y el enlace llega casi siempre desde el navegador
 * de LinkedIn, asi que la nube entera se queda en su seccion.
 *
 * El corte va por PESO, que es el orden en que `techCoverage` ya las devuelve.
 * Aqui se reordenaba por volumen bruto y eso ponia `office-365` —20 cursos de
 * una hora, peso 24— por delante de `gcp` —11 certificados, peso 102— en la
 * primera linea que lee alguien que evalua un perfil de datos. El peso lo fija
 * la curaduria ficha por ficha; el conteo solo dice cuantas veces se repitio un
 * curso de ofimatica. Un array de tecnologias "de primer nivel" escrito a mano
 * habria hecho lo mismo, pero seria una segunda fuente de verdad que se
 * desincroniza el dia que entre una ficha nueva.
 */
const techTop = tech.slice(0, 12);
/** Las cuatro de mas peso se realzan dentro de la nube: son el nucleo del
 *  stack, no una etiqueta mas de la misma tira. El corte sale del mismo orden
 *  por peso, sin lista escrita a mano. */
const NUCLEO = 4;
const { hours, covered, total: nCursos, itineraries } = hoursFloor(certs);
const hoy = new Date().toISOString().slice(0, 10);
// 68 cursos otorgan ademas certificado del PMI: otro documento, con su propio
// numero y sus PDU. Va como distintivo del curso y no como ficha aparte, para
// no duplicar cada titulo en el listado.
const conPmi = certs.filter((c) => c.pmi_credential_id);
const pdu = Math.round(conPmi.reduce((s, c) => s + (c.pmi_pdus ?? 0), 0) * 10) / 10;
const { years, undated } = timeline(certs);
// Los filtros corren en el cliente sobre el DOM ya renderizado: con 252 filas no
// hay nada que optimizar y evita enviar el corpus dos veces, una en HTML y otra
// en JSON. Cada fila lleva su propio heno de busqueda ya normalizado.
const anios = [...new Set(certs.map((c) => c.issued?.slice(0, 4)).filter(Boolean))]
  .sort().reverse() as string[];
const heno = (c: (typeof certs)[number]) =>
  [c.title, c.issuer, c.platform, ...c.tech, ...c.skills.slice(0, 8)]
    .join(' ').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
const ev = evidence(certs);
const maxYear = Math.max(1, ...years.map(([, n]) => n));
/** El año de mas actividad se pinta con el verde de estado en vez del azul.
 *  Es el unico dato del grafico que se lee sin comparar alturas. */
const anioPico = years.reduce((a, b) => (b[1] > a[1] ? b : a), years[0] ?? [0, 0])[0];
/**
 * Alto maximo de una columna del histograma, en px.
 *
 * En px y no en porcentaje porque el conteo va PEGADO encima de su barra, no en
 * una fila propia: en una banda de 110px con el numero arriba del todo, el «1»
 * de 2013 quedaba a 110px de una barra de 3px y no se leia como su etiqueta.
 * Con el conteo dentro de la columna hace falta reservarle sitio, y eso es una
 * resta de pixeles —110 de banda menos 16 de cifra— que un porcentaje no sabe
 * hacer. Los dos valores viven aqui y en la regla .col, que es donde se ven.
 */
const ALTO_BARRA = 94;
const pctDoc = Math.round((ev.withPdf / Math.max(1, certs.length)) * 100);
---
<Base title="Alejandro Retuert — Certificaciones">
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Registro verificable · Ingeniería y arquitectura de datos</p>
      <h1>Alejandro Retuert</h1>
      <p class="sub">Formación continua con el documento de cada credencial adjunto y comprobable.</p>
      <ul class="stats">
        <li>
          <b>{certs.length}</b><span>certificados</span>
          {anios.length > 0 && <i>{anios[anios.length - 1]}–{anios[0]}</i>}
        </li>
        <li class="eje"><b>{ev.official}</b><span>de organismo externo</span><i>examen o acreditación</i></li>
        <li><b>{hours} h</b><span>de contenido</span><i>{covered} de {nCursos} con dato</i></li>
        <li><b>{ev.withVerifyUrl}</b><span>verificables en el emisor</span><i>sin depender de este sitio</i></li>
        <li><b>{ev.withPdf}</b><span>con documento adjunto</span><i>{pctDoc}% del total</i></li>
        {conPmi.length > 0 && (
          <li><b>{conPmi.length}</b><span>con certificado PMI</span><i>{pdu} PDU</i></li>
        )}
      </ul>
      <div class="stack">
        <span class="stack-h">Stack con respaldo:</span>
        <span class="vh">Tecnologías con más certificados, ordenadas por peso: </span>
        {techTop.map((t, i) => (
          <code class:list={['tag', { core: i < NUCLEO }]}>{t.tech} <b>{t.n}</b></code>
        ))}
      </div>
      {itineraries > 0 && (
        <p class="disclaimer">
          Las horas excluyen {itineraries} itinerarios de LinkedIn Learning, que agrupan cursos
          ya contados en esta misma lista. Sumarlos daria una cifra mayor contando dos veces el
          mismo contenido.
        </p>
      )}
    </div>
  </header>

  <main class="wrap">
    <nav class="nav" aria-label="Secciones">
      <a href={urlCompetencias()}>Ver por competencias →</a>
    </nav>
    {featured.length > 0 && (
      <section>
        <h2><Icono nombre="estrella" px={17} />Credenciales destacadas <small>examen de organismo externo o curso de mayor peso</small></h2>
        <div class="grid feat">
          {featured.map((c) => (
            <article class="card">
              <a class="shot" href={urlCert(c.id)}>
                {c.thumb
                  ? <img src={urlThumb(c.thumb)} alt={`Certificado de ${c.title}`}
                         width={dims.get(c.thumb)?.w ?? 640} height={dims.get(c.thumb)?.h ?? 495}
                         loading="lazy" decoding="async" />
                  : <span class="sin-doc">Ver la ficha de {c.title}</span>}
              </a>
              <div class="card-body">
                <div class="card-meta">
                  <Chip variante={c.type}>{typeLabel(c.type)}</Chip>
                  {c.expires
                    ? (c.expires < hoy
                        ? <span class="estado exp">vencida {c.expires.slice(0, 4)}</span>
                        : <span class="estado vig">vigente hasta {c.expires.slice(0, 4)}</span>)
                    : c.verify_url && <span class="estado vig">verificable</span>}
                </div>
                <h3><a href={urlCert(c.id)}>{c.title}</a></h3>
                <p class="emisor">{c.issuer}{c.issued && ` · ${c.issued.slice(0, 4)}`}</p>
                {c.tech.length > 0 && (
                  <p class="techs">{c.tech.map((t) => <code>{t}</code>)}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section>
      <h2><Icono nombre="grafo" px={17} />Métricas de especialización <small>volumen por área y cadencia por año</small></h2>
      <div class="insights">
        <div class="panel">
          <p class="panel-h">Horas por área <span>orden por horas, no por número de cursos</span></p>
          <div class="bars">
            {areas.map((a) => (
              <div>
                <div class="bar-meta">
                  <span>{areaLabel(a.area)}</span>
                  <span class="bar-val">{a.h} h · {a.n} certs</span>
                </div>
                <span class="track"><span class="fill" style={`width:${(a.h / maxH) * 100}%`}></span></span>
              </div>
            ))}
          </div>
          <p class="pie">Lo técnico son cursos largos y lo transversal cursos de una hora: ordenar
            por volumen invierte la lectura.</p>
        </div>

        <div class="panel">
          <p class="panel-h">Cadencia por año <span>los años sin actividad se dibujan igual</span></p>
          <div class="years">
            {years.map(([y, n]) => (
              <div class="yr" title={`${y}: ${n} certificados`}>
                <span class="col">
                  {n > 0 && <span class:list={['yn', { pico: y === anioPico }]}>{n}</span>}
                  <span class:list={['yb', { pico: y === anioPico }]}
                        style={`height:${Math.max(n > 0 ? 3 : 0, (n / maxYear) * ALTO_BARRA)}px`}></span>
                </span>
                <span class="yl">{String(y).slice(2)}</span>
              </div>
            ))}
          </div>
          <p class="pie">
            {undated > 0 && <>{undated} certificados sin fecha registrada, fuera del gráfico. </>}
            Un año sin certificados se dibuja como columna vacía: el hueco es parte de lo que el
            gráfico dice.
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2><Icono nombre="pipeline" px={17} />Tecnologías <small>con dos o más certificados</small></h2>
      <div class="panel">
        <p class="techs big">{tech.map((t) => <code>{t.tech} <b>{t.n}</b></code>)}</p>
      </div>
    </section>

    <section>
      <h2><Icono nombre="tabla" px={17} />Catálogo completo <small>{certs.length} credenciales · indexable con Ctrl + F</small></h2>
      <form class="filtros" id="filtros" role="search" aria-label="Filtrar certificados">
        <label class="f grow">
          <span>Buscar</span>
          <input type="search" id="q" placeholder="título, emisor o tecnología"
                 autocomplete="off" />
        </label>
        <label class="f">
          <span>Área</span>
          <select id="f-area">
            <option value="">todas</option>
            {areas.map((a) => <option value={a.area}>{areaLabel(a.area)}</option>)}
          </select>
        </label>
        <label class="f">
          <span>Tipo</span>
          <select id="f-tipo">
            <option value="">todos</option>
            {Object.entries(TYPE_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </label>
        <label class="f">
          <span>Año</span>
          <select id="f-anio">
            <option value="">todos</option>
            {anios.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
        <fieldset class="toggles">
          <legend class="vh">Filtros de evidencia</legend>
          <label><input type="checkbox" id="f-verif" /> verificable en el emisor</label>
          <label><input type="checkbox" id="f-pmi" /> con certificado PMI</label>
          <label><input type="checkbox" id="f-ofi" /> de organismo externo</label>
        </fieldset>
        <p class="cuenta">
          <output id="cuenta" for="q f-area f-tipo f-anio">{certs.length}</output>{' '}
          de {certs.length} · <button type="reset" id="limpiar">limpiar</button>
        </p>
      </form>
      {conPmi.length > 0 && (
        <p class="note tight">{conPmi.length} de estos cursos otorgan además un certificado del
          Project Management Institute, con su propio número y sus PDU. Es otro documento del mismo
          curso, así que se enlaza aparte en vez de repetir el título en la lista.</p>
      )}
      <div class="tabla" role="region" aria-label="Listado completo de certificados" tabindex="0">
        <table>
          <thead>
            <tr>
              <th class="c-tit">Certificado</th>
              <th class="c-area">Área</th>
              <th class="c-tipo">Tipo</th>
              <th class="c-anio">Año</th>
              <th class="c-ev" title="A la izquierda la copia alojada aquí; a la derecha lo que comprueba el emisor">Evidencia</th>
            </tr>
          </thead>
          <tbody>
            {certs.map((c, i) => (
              <tr class:list={{ par: i % 2 === 1 }}
                  data-area={c.area} data-tipo={c.type} data-anio={c.issued?.slice(0, 4) ?? ''}
                  data-verif={c.verify_url ? '1' : ''} data-pmi={c.pmi_pdf ? '1' : ''}
                  data-ofi={c.official ? '1' : ''} data-q={heno(c)}>
                <td class="c-tit"><a class="tt" href={urlCert(c.id)}>{c.title}</a></td>
                <td class="c-area dim">{areaLabel(c.area)}</td>
                <td class="c-tipo"><Chip variante={c.type} sm>{typeLabel(c.type)}</Chip></td>
                <td class="c-anio">
                  <span class="anio">{c.issued?.slice(0, 4) ?? '—'}</span>
                  {c.expires && c.expires < hoy && <span class="estado exp" title={`Venció el ${c.expires}`}>vencida</span>}
                </td>
                <td class="c-ev">
                  {c.pdf
                    ? <a class="btn-doc" href={urlPdf(c.pdf)} target="_blank" rel="noopener noreferrer">PDF</a>
                    : <span class="dim">—</span>}
                  {c.pmi_pdf && (
                    <a class="btn-doc pmi" href={urlPdf(c.pmi_pdf)} target="_blank"
                       rel="noopener noreferrer"
                       title={`Certificado del Project Management Institute${c.pmi_pdus ? ` · ${c.pmi_pdus} PDU` : ''}`}>PMI</a>
                  )}
                  {c.verify_url && (
                    <a class="btn-doc ver" href={c.verify_url} rel="noopener noreferrer" target="_blank">emisor ↗</a>
                  )}
                  {c.pmi_verify_url && (
                    <a class="btn-doc pmi" href={c.pmi_verify_url} rel="noopener noreferrer" target="_blank"
                       title="Verificar el certificado del PMI en LinkedIn">PMI ↗</a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    // Filtrado en el cliente sobre las filas ya renderizadas. Sin framework y
    // sin volver a enviar el corpus: cada fila trae sus propios data-* y el
    // heno de busqueda ya normalizado desde el build.
    const form = document.getElementById('filtros');
    if (form) {
      // El formulario no envia nada: filtra en el cliente. Sin esto, un Enter
      // en la caja de busqueda dispara el envio implicito —un unico campo de
      // texto basta—, la pagina recarga y se pierden los filtros puestos.
      form.addEventListener('submit', (e) => e.preventDefault());
      const filas = /** @type {HTMLTableRowElement[]} */ ([...document.querySelectorAll('tbody tr')]);
      const cuenta = document.getElementById('cuenta');
      const q = /** @type {HTMLInputElement} */ (document.getElementById('q'));
      const sel = (id) => /** @type {HTMLSelectElement} */ (document.getElementById(id));
      const chk = (id) => /** @type {HTMLInputElement} */ (document.getElementById(id));

      // misma normalizacion que en el build: sin acentos y en minusculas, para
      // que "comunicacion" encuentre "Comunicación"
      const norm = (s) => s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '');

      function aplicar() {
        const t = norm(q.value.trim());
        const area = sel('f-area').value;
        const tipo = sel('f-tipo').value;
        const anio = sel('f-anio').value;
        const verif = chk('f-verif').checked;
        const pmi = chk('f-pmi').checked;
        const ofi = chk('f-ofi').checked;
        let n = 0;
        for (const fila of filas) {
          const d = fila.dataset;
          const ok =
            (!t || (d.q || '').includes(t)) &&
            (!area || d.area === area) &&
            (!tipo || d.tipo === tipo) &&
            (!anio || d.anio === anio) &&
            (!verif || d.verif === '1') &&
            (!pmi || d.pmi === '1') &&
            (!ofi || d.ofi === '1');
          fila.hidden = !ok;
          // La franja alterna se recalcula sobre las filas VISIBLES. Con
          // :nth-child se pintaria sobre la posicion original, asi que en cuanto
          // un filtro esconde una fila aparecen dos rayadas seguidas y la ayuda
          // de lectura se vuelve ruido. El build siembra la misma clase con el
          // mismo criterio, para que la tabla salga rayada sin esperar al script.
          if (ok) { fila.classList.toggle('par', n % 2 === 1); n++; }
        }
        if (cuenta) cuenta.textContent = String(n);
        form.dataset.vacio = n === 0 ? '1' : '';
      }

      form.addEventListener('input', aplicar);
      // reset dispara antes de que los campos se limpien
      form.addEventListener('reset', () => setTimeout(aplicar, 0));
      aplicar();
    }
  </script>

  <style>
    /* ── ENCABEZADO ───────────────────────────────────────────────────────── */
    /* Sin banda de color de fondo: el encabezado se separa del cuerpo con una
       regla de 1px, igual que el resto de las divisiones del sitio. Una banda
       tintada sobre #0d1117 obliga a recalcular el contraste de --muted en una
       superficie mas que solo existe aqui. */
    .hero { border-bottom: 1px solid var(--line); padding: 44px 0 34px; margin-bottom: 40px; }
    h1 { font-size: clamp(30px, 5vw, 42px); font-weight: 700; margin-bottom: 6px; }
    .sub { color: var(--muted); font-size: 17px; max-width: 62ch; }
    .stats { margin: 26px 0 0; }

    /* Nube de stack: caja propia con etiqueta, no una tira de pastillas suelta.
       Es lo primero que busca quien lee esto para un puesto tecnico. */
    .stack {
      display: flex; flex-wrap: wrap; gap: 7px; align-items: center;
      margin: 22px 0 0; padding: 12px 14px;
      background: color-mix(in srgb, var(--card) 55%, transparent);
      border: 1px solid var(--line); border-radius: var(--radius);
    }
    .stack-h { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-right: 4px; }
    /* Las cuatro de mas peso, realzadas. El tinte del acento las separa de las
       otras ocho sin cambiarles el tamaño ni sacarlas de la misma tira. */
    .tag.core { background: var(--accent-soft); border-color: var(--accent-borde); color: var(--accent); }
    .disclaimer { margin: 16px 0 0; max-width: 68ch; color: var(--dim); font-size: 12.5px; line-height: 1.55; }

    main { padding-bottom: 72px; }
    .nav { margin: 0 0 24px; font-family: var(--mono); font-size: 13px; }
    .nav a { color: var(--accent); text-decoration: none; }
    .nav a:hover { text-decoration: underline; }

    /* ── DESTACADOS ───────────────────────────────────────────────────────── */
    .grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
    .card {
      display: flex; flex-direction: column; overflow: hidden;
      background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
      transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .card:hover { border-color: var(--accent-borde); transform: translateY(-2px); }
    /* Marco del documento: alto fijo y `contain`, no un recorte. La miniatura
       ES la evidencia; recortarla a 16/10 corta el sello y la firma, que es
       justo lo que alguien mira. El alto fijo evita el salto de carga sin
       necesidad de proporcion declarada, y los atributos width/height siguen
       trayendo la medida real de cada archivo. */
    .shot {
      display: flex; align-items: center; justify-content: center;
      height: 180px; padding: 8px; background: var(--frame);
      border-bottom: 1px solid var(--line);
    }
    .shot img { width: 100%; height: 100%; object-fit: contain; }
    .sin-doc { font-family: var(--mono); font-size: 12px; color: var(--dim); }
    .card-body { display: flex; flex-direction: column; flex-grow: 1; padding: 15px 16px; }
    .card-meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 9px; }
    .card h3 { font-size: 16px; margin-bottom: 5px; }
    .card h3 a { text-decoration: none; }
    .card h3 a:hover { color: var(--accent); }
    .emisor { color: var(--muted); font-size: 13px; }
    .card .techs { margin-top: auto; padding-top: 13px; }

    /* Estado de vigencia. Sin fondo tintado a proposito: en la variante
       vencida, --alerta sobre un tinte del 15% cae a 4.35 y queda bajo AA. */
    .estado { font-family: var(--mono); font-size: 11px; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; }
    .estado.vig { color: var(--ok); }
    .estado.exp { color: var(--alerta); }
    .estado::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    /* ── PANELES DE METRICAS ──────────────────────────────────────────────── */
    .insights { display: grid; gap: 18px; grid-template-columns: 1fr 1fr; }
    .panel-h span { display: block; font-weight: 400; font-size: 11.5px; color: var(--dim); font-family: var(--mono); margin-top: 3px; }
    .pie { margin-top: 14px; font-size: 11.5px; line-height: 1.5; color: var(--dim); font-family: var(--mono); }
    .techs.big { line-height: 1.5; }

    /* Histograma con base alineada y conteo pegado a su columna.
       La banda de 110px la fija .col y el alto util de la barra sale de
       ALTO_BARRA en el frontmatter: los 16px de diferencia son el sitio del
       conteo, que se apoya sobre la barra en vez de flotar en una fila comun. */
    .years { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 5px; padding-top: 8px; border-bottom: 1px solid var(--line); }
    .yr { display: grid; grid-template-rows: 110px auto; justify-items: center; }
    .col { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; width: 100%; height: 110px; }
    .yb { width: 100%; background: var(--accent); border-radius: 2px 2px 0 0; opacity: .85; }
    .yb.pico { background: var(--ok); opacity: 1; }
    .yn { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-bottom: 3px; }
    .yn.pico { color: var(--ok); }
    .yl { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-top: 6px; }

    /* ── FILTROS ──────────────────────────────────────────────────────────── */
    .filtros { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 16px; margin: 0 0 14px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
    .f { display: flex; flex-direction: column; gap: 5px; font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; font-family: var(--mono); }
    .f.grow { flex: 1 1 220px; }
    .f input, .f select { font: inherit; font-family: inherit; font-size: 13px; text-transform: none; letter-spacing: 0; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 7px 9px; width: 100%; }
    .f input:focus-visible, .f select:focus-visible, .toggles input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .toggles { display: flex; flex-wrap: wrap; gap: 4px 16px; border: 0; font-size: 12.5px; }
    .toggles label { display: flex; align-items: center; gap: 7px; color: var(--muted); min-height: 24px; }
    /* 24x24 es el minimo de WCAG 2.2 (2.5.8) para un objetivo tactil. El
       checkbox por defecto mide 13px y en un telefono se falla al tocarlo. */
    .toggles input[type='checkbox'] { width: 24px; height: 24px; margin: 0; accent-color: var(--accent); }
    .cuenta { margin-left: auto; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
    .cuenta output { font-weight: 700; color: var(--titulo); }
    .cuenta button { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
    .note { color: var(--dim); font-size: 12.5px; line-height: 1.5; }
    .note.tight { margin: -4px 0 14px; max-width: 78ch; }

    /* ── TABLA DE 252 ─────────────────────────────────────────────────────── */
    /* El contenedor NO lleva overflow en escritorio, y no es un descuido:
       `overflow: hidden` lo convertiria en contexto de desplazamiento y el
       thead pegajoso pasaria a anclarse a la caja en vez de a la ventana, o
       sea dejaria de anclarse a nada. Las esquinas se redondean celda por
       celda arriba y la ultima fila se queda sin regla inferior abajo. */
    .tabla { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: visible; }
    .tabla:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    /* Encabezado fijo. Con 252 filas, en la 180 ya no se sabe que columna es
       cual, y el sitio no pagina a proposito: paginar rompe el Ctrl+F, que es
       como se busca de verdad en una lista asi.
       El fondo es solido y no translucido con blur: sobre un fondo difuminado
       el contraste depende de lo que pase por debajo, y ahi axe mide el estado
       en reposo y nunca lo que se ve al hacer scroll.
       La regla inferior va como sombra interior y no como border-bottom: con
       border-collapse el borde lo pinta la tabla, no la celda, y una celda
       pegajosa lo deja atras al desplazarse. */
    thead th { position: sticky; top: 0; z-index: 1; background: var(--card); box-shadow: inset 0 -2px 0 var(--line); }
    th { text-align: left; font-family: var(--mono); font-weight: 500; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; padding: 11px 14px; }
    th:first-child { border-top-left-radius: var(--radius); }
    th:last-child { border-top-right-radius: var(--radius); }
    /* 7px por fila: 252 filas a 11px son 1000px de aire que obligan a un scroll
       de mas sin aportar legibilidad. */
    td { padding: 7px 14px; border-bottom: 1px solid var(--line-suave); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: 0; }
    /* Franja alterna como ayuda de escaneo horizontal: cinco columnas y el ojo
       salta de fila al llegar a la derecha. La clase la mantiene el script
       sobre las filas visibles; el valor esta separado del realce porque los
       dos se pintan detras del mismo texto. */
    tbody tr.par { background: var(--cebra); }
    tbody tr { transition: background-color var(--dur) var(--ease); }
    /* Sobre una fila ya rayada el cambio de fondo es de dos valores y no se ve,
       asi que el realce lo cierra un riel de acento al borde izquierdo. Va como
       sombra interior: no se pinta detras de ningun texto y por tanto no toca
       el contraste de nada. */
    tbody tr:hover { background: var(--surface); box-shadow: inset 2px 0 0 var(--accent); }
    .c-tit { width: 44%; }
    .c-area { width: 20%; }
    .c-tipo { width: 10%; }
    .c-anio { width: 9%; }
    .c-ev { width: 17%; text-align: right; white-space: nowrap; }
    .c-ev .btn-doc + .btn-doc, .c-ev .btn-doc + .dim { margin-left: 5px; }
    .btn-doc.ver { color: var(--accent); }
    /* --dim (#7d8590) NO sirve aqui: sobre la franja alterna da 4.44 y sobre el
       realce 4.17, los dos bajo el minimo AA. --muted da 5.38 y 5.06. */
    .dim { color: var(--muted); font-size: 12.5px; }
    .tt { text-decoration: none; font-weight: 500; }
    .tt:hover { color: var(--accent); text-decoration: underline; }
    /* El año en monoespaciada: cuatro cifras de ancho fijo se leen en columna,
       que es justo lo que se hace al recorrer 252 filas ordenadas por fecha. */
    .anio { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
    .c-anio .estado { margin-left: 6px; font-size: 10px; }
    /* Hermano general, no adyacente. Entre el formulario y la tabla hay un <p>
       —la nota del PMI, que se emite siempre porque hay 68 cursos con
       acreditacion— asi que `.filtros + table` no encontraba nada y el aviso de
       "sin resultados" no llegaba a pintarse nunca. La tabla se quedaba muda. */
    .filtros[data-vacio='1'] ~ .tabla tbody::after { content: 'Ningún certificado coincide con estos filtros.'; display: block; padding: 20px 14px; color: var(--muted); }

    @media (max-width: 900px) {
      .insights { grid-template-columns: 1fr; }
    }
    /* 760px y no el corte de 640 del resto: el punto no es «movil», es el ancho
       en que la tabla deja de caber. Se redondea al alza porque la media query
       mide la ventana CON la barra de desplazamiento y clientWidth sin ella. */
    @media (max-width: 760px) {
      .tabla { overflow-x: auto; }
      .c-area { display: none; }
    }
    @media (max-width: 640px) {
      table { font-size: 12.5px; }
      .stats { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
    }
    @media (prefers-reduced-motion: reduce) {
      .card, tbody tr { transition: none; }
      .card:hover { transform: none; }
    }
  </style>
</Base>
