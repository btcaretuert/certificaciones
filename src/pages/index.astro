---
import Base from '@layouts/Base.astro';
import Chip from '@components/Chip.astro';
import Icono from '@components/Icono.astro';
import { publishedCertificates, selectFeatured } from '@lib/data';
import { dimWebp } from '@lib/webp';
import { countBy, hoursFloor, techCoverage, timeline, evidence } from '@lib/stats';
import { urlCert, urlCompetencias, urlPdf, urlThumb } from '@lib/urls';
import { areaLabel, typeLabel, TYPE_LABEL } from '@lib/labels';

const certs = await publishedCertificates();
const featured = selectFeatured(certs);

/**
 * Alto y ancho REALES de cada miniatura destacada.
 *
 * Antes iban fijos en 640x480 y ninguna miniatura mide eso: la mayoria es
 * 640x495 y tres de las destacadas son 596x842, es decir A4 vertical
 * declarado como horizontal. El navegador reserva el hueco con la proporcion
 * del atributo, asi que la pagina saltaba al cargar justo en el bloque que
 * mas arriba esta.
 *
 * Son siete lecturas en build, no 252: solo los destacados llevan miniatura
 * en esta pagina. La ficha hace lo mismo desde getStaticPaths.
 */
const dims = new Map(
  featured.filter((c) => c.thumb).map((c) => [c.thumb!, dimWebp(c.thumb!)]),
);
const areas = countBy(certs, (c) => c.area).map(([a, n]) => ({
  area: a,
  n,
  // las horas del area excluyen itinerarios por el mismo motivo que el total
  h: Math.round(certs.filter((c) => c.area === a && c.kind !== 'itinerario')
    .reduce((s, c) => s + (c.hours ?? 0), 0)),
})).sort((x, y) => y.h - x.h || y.n - x.n);
const maxH = Math.max(1, ...areas.map((a) => a.h));
const tech = techCoverage(certs).filter((t) => t.n >= 2);
/**
 * Las doce del encabezado. Las 30 de `tech` ocupan tres filas en escritorio
 * pero quince en un telefono, y el enlace llega casi siempre desde el navegador
 * de LinkedIn, asi que la nube entera se queda en su seccion.
 *
 * El corte va por PESO, que es el orden en que `techCoverage` ya las devuelve.
 * Aqui se reordenaba por volumen bruto y eso ponia `office-365` —20 cursos de
 * una hora, peso 24— por delante de `gcp` —11 certificados, peso 102— en la
 * primera linea que lee alguien que evalua un perfil de datos. El peso lo fija
 * la curaduria ficha por ficha; el conteo solo dice cuantas veces se repitio un
 * curso de ofimatica. Un array de tecnologias "de primer nivel" escrito a mano
 * habria hecho lo mismo, pero seria una segunda fuente de verdad que se
 * desincroniza el dia que entre una ficha nueva.
 */
const techTop = tech.slice(0, 12);
const { hours, covered, total: nCursos, itineraries } = hoursFloor(certs);
const hoy = new Date().toISOString().slice(0, 10);
// 68 cursos otorgan ademas certificado del PMI: otro documento, con su propio
// numero y sus PDU. Va como distintivo del curso y no como ficha aparte, para
// no duplicar cada titulo en el listado.
const conPmi = certs.filter((c) => c.pmi_credential_id);
const pdu = Math.round(conPmi.reduce((s, c) => s + (c.pmi_pdus ?? 0), 0) * 10) / 10;
const { years, undated } = timeline(certs);
// Los filtros corren en el cliente sobre el DOM ya renderizado: con 252 filas no
// hay nada que optimizar y evita enviar el corpus dos veces, una en HTML y otra
// en JSON. Cada fila lleva su propio heno de busqueda ya normalizado.
const anios = [...new Set(certs.map((c) => c.issued?.slice(0, 4)).filter(Boolean))]
  .sort().reverse() as string[];
const heno = (c: (typeof certs)[number]) =>
  [c.title, c.issuer, c.platform, ...c.tech, ...c.skills.slice(0, 8)]
    .join(' ').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
const ev = evidence(certs);
const maxYear = Math.max(1, ...years.map(([, n]) => n));
/**
 * Alto maximo de una columna del histograma, en px.
 *
 * En px y no en porcentaje porque el conteo va PEGADO encima de su barra, no en
 * una fila propia: en una banda de 110px con el numero arriba del todo, el «1»
 * de 2013 quedaba a 110px de una barra de 3px y no se leia como su etiqueta.
 * Con el conteo dentro de la columna hace falta reservarle sitio, y eso es una
 * resta de pixeles —110 de banda menos 16 de cifra— que un porcentaje no sabe
 * hacer. Los dos valores viven aqui y en la regla .col, que es donde se ven.
 */
const ALTO_BARRA = 94;
---
<Base title="Alejandro Retuert — Certificaciones">
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Formación continua verificable</p>
      <h1>Alejandro Retuert</h1>
      <p class="sub">Ingeniería y arquitectura de datos</p>
      <ul class="stats">
        <li><Icono nombre="certificado" px={20} /><b>{certs.length}</b><span>certificados</span></li>
        <li class="eje"><Icono nombre="escudo" px={20} /><b>{ev.official}</b><span>de organismo externo</span></li>
        <li><Icono nombre="documento" px={20} /><b>{ev.withPdf}</b><span>con documento adjunto</span></li>
        <li><Icono nombre="verificable" px={20} /><b>{ev.withVerifyUrl}</b><span>verificables en el emisor</span></li>
        <li><Icono nombre="reloj" px={20} /><b>{hours}</b><span>horas de contenido <i>({covered} de {nCursos} con dato)</i></span></li>
        {conPmi.length > 0 && (
          <li><Icono nombre="pmi" px={20} /><b>{conPmi.length}</b><span>con certificado PMI <i>({pdu} PDU)</i></span></li>
        )}
      </ul>
      <p class="stack">
        <span class="vh">Tecnologías con más respaldo: </span>
        {techTop.map((t) => <code>{t.tech} <b>{t.n}</b></code>)}
      </p>
      {itineraries > 0 && (
        <p class="disclaimer">
          Las horas excluyen {itineraries} itinerarios de LinkedIn Learning, que agrupan cursos
          ya contados en esta misma lista. Sumarlos daria una cifra mayor contando dos veces el
          mismo contenido.
        </p>
      )}
    </div>
  </header>

  <main class="wrap">
    <nav class="nav" aria-label="Secciones">
      <a href={urlCompetencias()}>Ver por competencias →</a>
    </nav>
    {featured.length > 0 && (
      <section>
        <h2><Icono nombre="estrella" px={17} />Destacados</h2>
        <div class="grid feat">
          {featured.map((c) => (
            <article class="card hi">
              {c.thumb && (
                <a class="shot" href={urlCert(c.id)}>
                  <img src={urlThumb(c.thumb)} alt={`Certificado de ${c.title}`}
                       width={dims.get(c.thumb)?.w ?? 640} height={dims.get(c.thumb)?.h ?? 495}
                       loading="lazy" decoding="async" />
                </a>
              )}
              <Chip variante={c.type}>{typeLabel(c.type)}</Chip>
              <h3><a href={urlCert(c.id)}>{c.title}</a></h3>
              <p class="meta">
                {c.issuer}{c.issued && ` · ${c.issued.slice(0, 4)}`}
                {c.expires && (c.expires < hoy
                  ? <span class="exp">vencida {c.expires.slice(0, 4)}</span>
                  : <span class="vig">vigente hasta {c.expires.slice(0, 4)}</span>)}
              </p>
              {c.tech.length > 0 && <p class="techs">{c.tech.map((t) => <code>{t}</code>)}</p>}
            </article>
          ))}
        </div>
      </section>
    )}

    <section>
      <h2><Icono nombre="grafo" px={17} />Por área <small>ordenado por horas de contenido, no por número de cursos</small></h2>
      <div class="bars">
        {areas.map((a) => (
          <div class="bar">
            <span class="lbl">{areaLabel(a.area)}</span>
            <span class="track"><span class="fill" style={`width:${(a.h / maxH) * 100}%`}></span></span>
            <span class="num">{a.h} h</span>
            <span class="num sub">{a.n}</span>
          </div>
        ))}
      </div>
      <p class="note">La columna de la derecha es el número de credenciales. Lo técnico son cursos
        largos y lo transversal cursos de una hora: ordenar por volumen invierte la lectura.</p>
    </section>

    <section>
      <h2><Icono nombre="pipeline" px={17} />Tecnologías <small>con dos o más certificados</small></h2>
      <p class="techs big">{tech.map((t) => <code>{t.tech} <b>{t.n}</b></code>)}</p>
    </section>

    <section>
      <h2><Icono nombre="barras" px={17} />Actividad por año</h2>
      <div class="years">
        {years.map(([y, n]) => (
          <div class="yr" title={`${y}: ${n} certificados`}>
            <span class="col">
              {n > 0 && <span class="yn">{n}</span>}
              <span class="yb" style={`height:${Math.max(n > 0 ? 3 : 0, (n / maxYear) * ALTO_BARRA)}px`}></span>
            </span>
            <span class="yl">{String(y).slice(2)}</span>
          </div>
        ))}
      </div>
      {undated > 0 && <p class="note">{undated} certificados sin fecha registrada, no incluidos en el gráfico.</p>}
    </section>

    <section>
      <h2><Icono nombre="tabla" px={17} />Todos los certificados <small>{certs.length}</small></h2>
      <form class="filtros" id="filtros" role="search" aria-label="Filtrar certificados">
        <label class="f grow">
          <span>Buscar</span>
          <input type="search" id="q" placeholder="título, emisor o tecnología"
                 autocomplete="off" />
        </label>
        <label class="f">
          <span>Área</span>
          <select id="f-area">
            <option value="">todas</option>
            {areas.map((a) => <option value={a.area}>{areaLabel(a.area)}</option>)}
          </select>
        </label>
        <label class="f">
          <span>Tipo</span>
          <select id="f-tipo">
            <option value="">todos</option>
            {Object.entries(TYPE_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </label>
        <label class="f">
          <span>Año</span>
          <select id="f-anio">
            <option value="">todos</option>
            {anios.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
        <fieldset class="toggles">
          <legend class="vh">Filtros de evidencia</legend>
          <label><input type="checkbox" id="f-verif" /> verificable en el emisor</label>
          <label><input type="checkbox" id="f-pmi" /> con certificado PMI</label>
          <label><input type="checkbox" id="f-ofi" /> de organismo externo</label>
        </fieldset>
        <p class="cuenta">
          <output id="cuenta" for="q f-area f-tipo f-anio">{certs.length}</output>{' '}
          de {certs.length} · <button type="reset" id="limpiar">limpiar</button>
        </p>
      </form>
      {conPmi.length > 0 && (
        <p class="note tight">{conPmi.length} de estos cursos otorgan además un certificado del
          Project Management Institute, con su propio número y sus PDU. Es otro documento del mismo
          curso, así que se enlaza aparte en vez de repetir el título en la lista.</p>
      )}
      <div class="tabla" role="region" aria-label="Listado completo de certificados" tabindex="0">
        <table>
          <thead><tr><th>Certificado</th><th>Área</th><th>Tipo</th><th>Año</th><th title="Copia del certificado, alojada en este sitio">Documento</th><th title="Comprobable en el sitio del emisor, sin depender de mí">Verificable</th></tr></thead>
          <tbody>
            {certs.map((c, i) => (
              <tr class:list={{ par: i % 2 === 1 }}
                  data-area={c.area} data-tipo={c.type} data-anio={c.issued?.slice(0, 4) ?? ''}
                  data-verif={c.verify_url ? '1' : ''} data-pmi={c.pmi_pdf ? '1' : ''}
                  data-ofi={c.official ? '1' : ''} data-q={heno(c)}>
                <td><a class="tt" href={urlCert(c.id)}>{c.title}</a></td>
                <td class="dim">{areaLabel(c.area)}</td>
                <td><Chip variante={c.type} sm>{typeLabel(c.type)}</Chip></td>
                <td class="dim anio">
                  {c.issued?.slice(0, 4) ?? '—'}
                  {c.expires && c.expires < hoy && <span class="exp" title={`Vencio el ${c.expires}`}>vencida</span>}
                </td>
                <td class="docs">
                  {c.pdf
                    ? <a class="doc" href={urlPdf(c.pdf)} target="_blank" rel="noopener noreferrer">PDF ↗</a>
                    : <span class="dim">—</span>}
                  {c.pmi_pdf && (
                    <a class="doc pmi" href={urlPdf(c.pmi_pdf)} target="_blank"
                       rel="noopener noreferrer"
                       title={`Certificado del Project Management Institute${c.pmi_pdus ? ` · ${c.pmi_pdus} PDU` : ''}`}>PMI ↗</a>
                  )}
                </td>
                <td class="docs">
                  {c.verify_url
                    ? <a class="ok" href={c.verify_url} rel="noopener noreferrer" target="_blank">emisor ↗</a>
                    : <span class="dim">—</span>}
                  {c.pmi_verify_url && (
                    <a class="ok pmi" href={c.pmi_verify_url} rel="noopener noreferrer" target="_blank"
                       title="Verificar el certificado del PMI en LinkedIn">PMI ↗</a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    // Filtrado en el cliente sobre las filas ya renderizadas. Sin framework y
    // sin volver a enviar el corpus: cada fila trae sus propios data-* y el
    // heno de busqueda ya normalizado desde el build.
    const form = document.getElementById('filtros');
    if (form) {
      // El formulario no envia nada: filtra en el cliente. Sin esto, un Enter
      // en la caja de busqueda dispara el envio implicito —un unico campo de
      // texto basta—, la pagina recarga y se pierden los filtros puestos.
      form.addEventListener('submit', (e) => e.preventDefault());
      const filas = /** @type {HTMLTableRowElement[]} */ ([...document.querySelectorAll('tbody tr')]);
      const cuenta = document.getElementById('cuenta');
      const q = /** @type {HTMLInputElement} */ (document.getElementById('q'));
      const sel = (id) => /** @type {HTMLSelectElement} */ (document.getElementById(id));
      const chk = (id) => /** @type {HTMLInputElement} */ (document.getElementById(id));

      // misma normalizacion que en el build: sin acentos y en minusculas, para
      // que "comunicacion" encuentre "Comunicación"
      const norm = (s) => s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '');

      function aplicar() {
        const t = norm(q.value.trim());
        const area = sel('f-area').value;
        const tipo = sel('f-tipo').value;
        const anio = sel('f-anio').value;
        const verif = chk('f-verif').checked;
        const pmi = chk('f-pmi').checked;
        const ofi = chk('f-ofi').checked;
        let n = 0;
        for (const fila of filas) {
          const d = fila.dataset;
          const ok =
            (!t || (d.q || '').includes(t)) &&
            (!area || d.area === area) &&
            (!tipo || d.tipo === tipo) &&
            (!anio || d.anio === anio) &&
            (!verif || d.verif === '1') &&
            (!pmi || d.pmi === '1') &&
            (!ofi || d.ofi === '1');
          fila.hidden = !ok;
          // La franja alterna se recalcula sobre las filas VISIBLES. Con
          // :nth-child se pintaria sobre la posicion original, asi que en cuanto
          // un filtro esconde una fila aparecen dos rayadas seguidas y la ayuda
          // de lectura se vuelve ruido. El build siembra la misma clase con el
          // mismo criterio, para que la tabla salga rayada sin esperar al script.
          if (ok) { fila.classList.toggle('par', n % 2 === 1); n++; }
        }
        if (cuenta) cuenta.textContent = String(n);
        form.dataset.vacio = n === 0 ? '1' : '';
      }

      form.addEventListener('input', aplicar);
      // reset dispara antes de que los campos se limpien
      form.addEventListener('reset', () => setTimeout(aplicar, 0));
      aplicar();
    }
  </script>

  <style>
      /* Se queda con ambito: en global empataria con la regla .sub de la
         portada y perderia por orden de hojas. */
      .num.sub { font-size: 12px; }
    .hero { background: var(--accent-soft); border-bottom: 1px solid var(--line); padding: 48px 0 34px; }
    h1 { font-size: clamp(30px, 5vw, 44px); }
    .sub { margin: 4px 0 0; color: var(--muted); font-size: 17px; }
    /* La retícula y la tipografía viven en primitivas.css: competencias.astro
       declaraba esto mismo palabra por palabra. Aquí solo el margen. */
    .stats { margin: 26px 0 0; }
    /* Sin opacity: atenuar --muted lo baja de 4.70 a 2.95 sobre --accent-soft. */
    .stats i { font-style: normal; }
    /* Tira de stack en el encabezado. Es lo primero que busca quien lee esto
       para un puesto técnico y estaba en la quinta sección, bajo el pliegue. */
    .stack { display: flex; flex-wrap: wrap; gap: 6px; margin: 22px 0 0; }
    .stack code { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 3px 9px; font-size: 11.5px; }
    /* El respaldo va atenuado: la etiqueta es lo que se busca, el numero es
       contexto. En el tono del texto los doce numeros compiten con los doce
       nombres y la tira deja de leerse de un golpe. */
    .stack code b { color: var(--muted); font-weight: 600; }
    main { padding: 34px 0 70px; }
    section { margin-bottom: 42px; }
    .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 15px; overflow: hidden; }
    .card.hi { transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .card.hi:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); }
    .card h3 { font-size: 15px; margin: 8px 0 5px; }
    .meta { margin: 0; color: var(--muted); font-size: 13px; }
    .techs { margin: 9px 0 0; display: flex; flex-wrap: wrap; gap: 5px; }
    .bar { display: grid; grid-template-columns: 210px 1fr 52px 34px; align-items: center; gap: 12px; font-size: 13.5px; }
    .vig { display: inline-block; margin-left: 6px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); border: 1px solid currentColor; border-radius: 4px; padding: 1px 5px 1px 4px; }
    /* Punto de estado. Va con content vacio y fondo, no con el caracter '●':
       un bullet en el texto lo anuncian algunos lectores de pantalla como
       "circulo negro" en medio de la fecha de vigencia. */
    .vig::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-right: 5px; border-radius: 50%; background: currentColor; vertical-align: .1em; }
    /* Histograma con base alineada y conteo pegado a su columna.
       La banda de 110px la fija .col y el alto util de la barra sale de
       ALTO_BARRA en el frontmatter: los 16px de diferencia son el sitio del
       conteo, que se apoya sobre la barra en vez de flotar en una fila comun.
       Los años sin certificados se dibujan como columna vacia y no se omiten:
       el hueco entre 2014 y 2018 es parte de lo que el grafico dice. */
    .years { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 5px; padding-top: 10px; }
    .yr { display: grid; grid-template-rows: 110px auto; justify-items: center; }
    .col { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; width: 100%; height: 110px; }
    .yb { width: 100%; background: var(--accent); border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
    .yl { font-size: 11px; color: var(--muted); margin-top: 5px; font-variant-numeric: tabular-nums; }
    .yn { font-size: 10px; color: var(--muted); margin-bottom: 3px; font-variant-numeric: tabular-nums; }
    .note { color: var(--muted); font-size: 12.5px; margin-top: 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    /* Encabezado fijo. Con 252 filas, en la 180 ya no se sabe que columna es
       cual, y el sitio no pagina a proposito: paginar rompe el Ctrl+F, que es
       como se busca de verdad en una lista asi.
       El fondo es solido y no translucido con blur: sobre un fondo difuminado
       el contraste depende de lo que pase por debajo, y ahi axe mide el estado
       en reposo y nunca lo que se ve al hacer scroll.
       La regla inferior va como sombra interior y no como border-bottom: con
       border-collapse el borde lo pinta la tabla, no la celda, y una celda
       pegajosa lo deja atras al desplazarse. */
    thead th { position: sticky; top: 0; z-index: 1; background: var(--bg); }
    th { text-align: left; font-weight: 600; color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; padding: 9px 10px; box-shadow: inset 0 -1px 0 var(--line); }
    /* 7px por fila: 252 filas a 9px son 500px de aire que obligan a un scroll
       de mas sin aportar legibilidad. */
    td { padding: 7px 10px; border-bottom: 1px solid var(--line); }
    /* Franja alterna como ayuda de escaneo horizontal: seis columnas y el ojo
       salta de fila al llegar a la derecha. La clase la mantiene el script
       sobre las filas visibles; el valor esta separado del realce porque los
       dos se pintan detras del mismo texto y --alerta ya viene justo. */
    tbody tr.par { background: var(--cebra); }
    /* Realce neutro, no --accent-soft: sobre ese fondo .dim cae a 2.95.
       Sobre una fila ya rayada el cambio de fondo es de dos valores y no se ve,
       asi que el realce lo cierra un riel de acento al borde izquierdo. Va como
       sombra interior: no se pinta detras de ningun texto y por tanto no toca
       el contraste de nada. */
    tbody tr { transition: background-color var(--dur) var(--ease); }
    tbody tr:hover { background: var(--surface); box-shadow: inset 2px 0 0 var(--accent); }
    .dim { color: var(--muted); }
    /* El año en monoespaciada: cuatro cifras de ancho fijo se leen en columna,
       que es justo lo que se hace al recorrer 252 filas ordenadas por fecha. */
    .anio { font-family: var(--mono); font-size: 12px; font-variant-numeric: tabular-nums; }
    /* Micro-pastillas en vez de enlaces subrayados. Son cuatro por fila y hasta
       500 en la tabla: el subrayado por omision del navegador convertia la
       columna de evidencia en una mancha. */
    .ok, .doc { display: inline-block; font-size: 11px; font-weight: 600; text-decoration: none; padding: 1px 6px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--accent); }
    .ok:hover, .doc:hover { border-color: currentColor; background: var(--card); }
    .docs { white-space: nowrap; }
    .pmi { margin-left: 5px; color: var(--ges); }
    .note.tight { margin: -4px 0 12px; max-width: 76ch; }
    .nav { margin: 0 0 22px; font-size: 13.5px; }
    .nav a { color: var(--accent); font-weight: 600; text-decoration: none; }
    .nav a:hover { text-decoration: underline; }
    .shot { display: block; margin: -14px -15px 12px; border-bottom: 1px solid var(--line); background: var(--bg); }
    .shot { overflow: hidden; }
    /* Más lenta que la tarjeta a propósito: el desfase entre el contenedor y su
       contenido es lo que da sensación de material y no de dos transiciones. */
    /* Proporcion fija en CSS en vez de un alto de 116px: el recorte se adapta
       al ancho de la columna y todas las tarjetas de una fila siguen midiendo
       igual. Los atributos width/height del <img> se quedan con la medida real
       de cada archivo —hay verticales A4 entre las destacadas— porque son los
       que el navegador usa para reservar el hueco antes de que llegue el CSS.
       `height: auto` no es decorativo: sin el, ese atributo cuenta como alto
       explicito y `aspect-ratio` no llega a aplicarse; la tarjeta pasaba a
       medir el alto del certificado entero, 495 o 842px. */
    .shot img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; border-radius: var(--radius) var(--radius) 0 0; transition: transform .25s var(--ease); }
    .card.hi:hover .shot img { transform: scale(1.03); }
    .card h3 a { text-decoration: none; }
    .card h3 a:hover { text-decoration: underline; }
    .tt { text-decoration: none; }
    .tt:hover { text-decoration: underline; color: var(--accent); }
    .filtros { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 14px; margin: 0 0 14px; padding: 13px 14px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-1); }
    .f { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
    .f.grow { flex: 1 1 210px; }
    .f input, .f select { font: inherit; font-size: 13.5px; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 7px; padding: 6px 9px; width: 100%; }
    .f input:focus-visible, .f select:focus-visible, .toggles input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .toggles { display: flex; flex-wrap: wrap; gap: 4px 14px; border: 0; margin: 0; padding: 0; font-size: 12.5px; }
    .toggles label { display: flex; align-items: center; gap: 7px; color: var(--muted); min-height: 24px; }
    /* 24x24 es el minimo de WCAG 2.2 (2.5.8) para un objetivo tactil. El
       checkbox por defecto mide 13px y en un telefono se falla al tocarlo. */
    .toggles input[type='checkbox'] { width: 24px; height: 24px; margin: 0; accent-color: var(--accent); }
    .cuenta { margin: 0 0 0 auto; font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .cuenta output { font-weight: 700; color: var(--fg); }
    .cuenta button { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
    /* Hermano general, no adyacente. Entre el formulario y la tabla hay un <p>
       —la nota del PMI, que se emite siempre porque hay 68 cursos con
       acreditacion— asi que `.filtros + table` no encontraba nada y el aviso de
       "sin resultados" no llegaba a pintarse nunca. La tabla se quedaba muda. */
    .filtros[data-vacio='1'] ~ .tabla tbody::after { content: 'Ningún certificado coincide con estos filtros.'; display: block; padding: 18px 10px; color: var(--muted); }
    .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .exp { display: inline-block; margin-left: 6px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--alerta); border: 1px solid currentColor; border-radius: 4px; padding: 1px 4px; }
    .disclaimer { margin: 16px 0 0; max-width: 62ch; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
    /* Seis columnas no caben en un telefono, y no es cuestion de apretarlas:
       el minimo lo fijan los propios encabezados —«Verificable» mide 132px a
       11.5px en versalitas—, asi que ocultar la columna de area dejaba la tabla
       en 571px sobre un ancho util de 350. Antes de esto desbordaba el
       DOCUMENTO entero: la portada se desplazaba en horizontal completa, con
       encabezado y tarjetas incluidos, en cualquier telefono.
       El desplazamiento se confina a la tabla y solo en movil: en escritorio el
       contenedor se queda en `visible` para no convertirse en contexto de
       scroll, que es lo que dejaria de anclar el thead pegajoso.
       Va con tabindex y nombre porque una region desplazable a la que no se
       llega con el teclado es un fallo serio de WCAG (2.1.1), no un detalle. */
    .tabla { overflow: visible; }
    .tabla:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    /* 760px y no el corte de 640 del resto: el punto no es «movil», es el ancho
       en que la tabla deja de caber. Su minimo es 696px —constante, lo fijan los
       encabezados— mas los 40px de margen de .wrap, o sea 736px de ventana. Se
       redondea a 760 porque la media query mide la ventana CON la barra de
       desplazamiento y clientWidth sin ella: sin ese margen, entre 736 y 753 la
       consulta dice que cabe y en pantalla no cabe. */
    @media (max-width: 760px) { .tabla { overflow-x: auto; } }
    @media (max-width: 640px) {
      .bar { grid-template-columns: 118px 1fr 44px 28px; font-size: 12.5px; }
      table { font-size: 12.5px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .card.hi, .shot img, tbody tr { transition: none; }
      .card.hi:hover { transform: none; }
      .card.hi:hover .shot img { transform: none; }
    }
  </style>
</Base>
